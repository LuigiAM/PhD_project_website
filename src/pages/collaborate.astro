---
import Layout from '../layouts/Layout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { Image } from 'astro:assets';
import { PROJECT, PHASE_COUNT, PRIMARY_EMAIL, mailto } from '../data/project';
import codesignTools from '../assets/images/co-design-tools.jpg';
import achievementsChart from '../assets/images/achievements-chart.jpg';
import pixelWatchDemo from '../assets/images/pixel-watch-demo.jpg';

const cards = [
  {
    id: 'research',
    title: 'For Researchers & Clinical Partners',
    tagline: 'Help take emotion monitoring from co-design into clinical evaluation',
    bullets: [
      'Clinical trials and evaluation studies of MEMoPAD in real care pathways',
      'NHS collaborations with services supporting people with anxiety disorders',
      'Academic collaboration on emotion recognition algorithms and co-design methodology',
      'Joint grant applications (NIHR, UKRI, EU Horizon, etc.)'
    ],
    cta: "Let's discuss collaboration",
    subject: 'Research Collaboration Inquiry',
    image: codesignTools
  },
  {
    id: 'funding',
    title: 'For Investors & Grant Bodies',
    tagline: 'Back the move from research prototype to a tool people can actually use',
    bullets: [
      `${PROJECT.fundingTotal} in competitive funding secured from NHS, UWE Bristol and industry to date`,
      `${PHASE_COUNT} co-design phases with patients, carers and clinicians (${PROJECT.participantsWording})`,
      'Working prototypes of the patient app, smartwatch app and clinician dashboard',
      'Designed from day one to fit into clinical pathways; exploring commercialisation routes'
    ],
    cta: 'Explore funding opportunities',
    subject: 'Funding & Support Inquiry',
    image: achievementsChart
  },
  {
    id: 'industry',
    title: 'For Product & R&D Teams',
    tagline: 'Bring co-designed emotion monitoring into wearable health products',
    bullets: [
      'Real-world use of emotion monitoring on consumer wearables (Google Pixel Watch 2)',
      'Licensing, partnership and commercialisation conversations',
      'Expertise bridging clinical research, user-centred design and technical implementation',
      'Deep understanding of clinical and user needs for mental health features'
    ],
    cta: "Let's connect",
    subject: 'Industry Partnership Inquiry',
    image: pixelWatchDemo
  }
];
---

<Layout
  title="Collaborate: Next Steps for MEMoPAD | MEMoPAD"
  description="Help MEMoPAD reach the people who need it: commercialisation, NHS collaborations and clinical trials for co-designed wearable emotion monitoring in anxiety care."
>
  <section class="container page-hero">
    <h1>Let's Work Together</h1>
    <p class="hero-intro">
      MEMoPAD is in its final co-design phase, with thesis submission expected by the end of 2026 and the viva by March 2027. I'm now exploring the next steps so that people can actually use this tool, including commercialisation, collaborations with the NHS, and clinical trials. If you could help MEMoPAD get there, I'd love to connect.
    </p>

    <p class="achievements-link">
      <a href="/achievements/">View project milestones & track record →</a>
    </p>
  </section>

  <section class="container cards-section" aria-label="Ways to collaborate">
    <div class="opportunity-grid">
      {cards.map(card => (
        <article class="opportunity-card" id={card.id}>
          <div class="card-image">
            <Image src={card.image} alt="" widths={[400, 700]} width={Math.min(700, card.image.width)} sizes="(max-width: 900px) 100vw, 340px" />
          </div>
          <div class="card-content">
            <h2>{card.title}</h2>
            <p class="card-tagline">{card.tagline}</p>
            <ul class="card-bullets">
              {card.bullets.map(bullet => <li>{bullet}</li>)}
            </ul>
            <a href={mailto(card.subject)} class="button card-cta">{card.cta}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container contact-section">
    <h2>Do you have questions or curiosities?</h2>
    <p>Reach me directly at <a href={mailto()}>{PRIMARY_EMAIL}</a> or connect on <a href="https://www.linkedin.com/in/luigiandreamoretti/" target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
    <p>More info on the <a href="/contact/">Contact page</a>.</p>

    <ShareButtons
      pageTitle="Work With Me - MEMoPAD Project"
      shareDescription="Help MEMoPAD, a co-designed wearable emotion monitoring tool for anxiety care, reach the people who need it."
    />
  </section>
</Layout>

<style>
  .page-hero {
    text-align: center;
    padding-top: 4rem;
    padding-bottom: 1rem;
  }
  .page-hero h1 {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }
  .hero-intro {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto;
  }
  .achievements-link {
    margin-top: 1rem;
  }
  .achievements-link a {
    color: var(--color-primary-strong);
    font-weight: 700;
    text-decoration: none;
    font-size: 1.1rem;
  }
  .achievements-link a:hover {
    text-decoration: underline;
  }

  .cards-section {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  .opportunity-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .opportunity-card {
    background-color: var(--color-white);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    display: flex;
    flex-direction: column;
    scroll-margin-top: 5rem;
  }
  .card-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background-color: var(--color-background);
  }
  .card-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .card-content h2 {
    font-size: 1.5rem;
    line-height: 1.3;
    margin-bottom: 0.75rem;
    color: var(--color-primary-strong);
  }
  .card-tagline {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }
  .card-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }
  .card-bullets li {
    padding-left: 1.75rem;
    margin-bottom: 0.85rem;
    position: relative;
    line-height: 1.6;
  }
  .card-bullets li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary-strong);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .card-cta {
    align-self: flex-start;
  }

  .contact-section {
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .contact-section h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .contact-section p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .contact-section p a {
    color: var(--color-primary-strong);
    font-weight: 700;
    text-decoration: none;
  }
  .contact-section p a:hover {
    text-decoration: underline;
  }

  @media (max-width: 1000px) {
    .opportunity-grid {
      grid-template-columns: 1fr;
      max-width: 640px;
      margin: 0 auto;
    }
  }
  @media (max-width: 768px) {
    .page-hero h1 {
      font-size: 2.5rem;
    }
    .card-content {
      padding: 1.5rem;
    }
  }
</style>
