---
// src/pages/newsletter/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NewsletterCard from '../../components/NewsletterCard.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import SubscribeButtons from '../../components/SubscribeButtons.astro';

// Newest first
const posts = (await getCollection('newsletter')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout
  title="Newsletter Archive | MEMoPAD"
  description="Every monthly MEMoPAD newsletter since July 2024: research progress, co-design insights and project milestones."
  breadcrumbName="Newsletter"
>
  <section class="container">
    <div class="archive-header">
      <h1>Newsletter Archive</h1>
      <p>A complete archive of our monthly updates, detailing our research progress, co-design insights, and project milestones.</p>
      <SubscribeButtons />
      <p class="rss-link"><a href="/rss.xml">Or follow via RSS</a></p>
    </div>

    <div class="post-grid">
      {posts.map(post => (
        <NewsletterCard
          href={`/newsletter/${post.id}/`}
          title={post.data.title}
          issue={post.data.issue}
          date={post.data.date}
          excerpt={post.data.description}
        />
      ))}
    </div>

    <div class="share-wrapper">
      <ShareButtons
        pageTitle="MEMoPAD Newsletter Archive"
        shareDescription="Explore the complete archive of the MEMoPAD project newsletter for insights into our co-design process and research findings."
      />
    </div>
  </section>
</Layout>

<style>
  .archive-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  .archive-header h1 {
    font-size: 3rem;
  }
  .archive-header p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0.5rem auto 2rem;
  }
  .archive-header .rss-link {
    margin: 1rem auto 0;
    font-size: 0.95rem;
  }
  .rss-link a {
    color: var(--color-primary-strong);
    font-weight: 700;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .share-wrapper {
    margin-top: 4rem;
  }
</style>
