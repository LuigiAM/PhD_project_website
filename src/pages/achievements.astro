---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import InteractiveTimeline from '../components/InteractiveTimeline.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { PROJECT } from '../data/project';
import heroBanner from '../assets/images/achievements-hero-banner.jpg';
---

<Layout
  title="Achievements & Milestones: Funding and Papers | MEMoPAD"
  description={`${PROJECT.fundingTotal} in competitive funding, papers at HEALTHINF, ACM Interactive Health and a CHI workshop, and seven co-design phases. MEMoPAD's research milestones.`}
>
  <section class="hero-banner">
    <Image src={heroBanner} alt="" widths={[800, 1400, 2000]} width={Math.min(2000, heroBanner.width)} sizes="100vw" loading="eager" fetchpriority="high" />
  </section>

  <section class="container">
    <div class="achievements-header">
      <h1>Achievements & Milestones</h1>
      <p class="intro">Funding, publications and co-design progress, newest first. Choose a category below. Abstracts, PDFs and citations are on the <a href="/publications/">Publications</a> page.</p>
    </div>

    <InteractiveTimeline />

    <section class="cta-section">
      <div class="cta-box">
        <h2>Interested in what's next?</h2>
        <p>These milestones represent years of research and collaboration. If you're exploring partnerships, funding opportunities, or ways to bring this work into your organisation, let's connect.</p>
        <a href="/collaborate/" class="button">Explore Collaboration Opportunities</a>
      </div>
    </section>

    <ShareButtons pageTitle="MEMoPAD Project Achievements & Milestones" />
  </section>
</Layout>

<style>
  .hero-banner {
    width: 100%;
    height: 350px;
    margin-bottom: 0;
  }
  .hero-banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .achievements-header {
    text-align: center;
    margin-bottom: 1rem;
  }
  .achievements-header h1 {
    font-size: 3rem;
  }
  .intro {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }

  .cta-section {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }
  .cta-box {
    text-align: center;
    background-color: var(--color-background);
    padding: 3rem;
    border-radius: 12px;
    border: 2px solid var(--color-primary);
  }
  .cta-box h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .cta-box p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto 2rem;
  }
  .cta-box .button {
    padding: 1rem 2rem;
  }

  @media (max-width: 600px) {
    .achievements-header h1 { font-size: 2.25rem; }
    .cta-box { padding: 2rem 1.25rem; }
  }
</style>
