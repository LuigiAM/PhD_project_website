---
import { PRIMARY_EMAIL, mailto } from '../data/project';

// Get the current page's path to determine the active link
const currentPath = Astro.url.pathname;

type NavLink = { href: string; text: string; children?: { href: string; text: string }[] };

// Define navigation links in an array for easier management
const navLinks: NavLink[] = [
  { href: "/project-story/", text: "Project Story" },
  {
    href: "/research/",
    text: "The Research",
    // Sub-pages of The Research. Co-design keeps its /co-design/ address (QR code on the Summit poster).
    children: [
      { href: "/co-design/", text: "Co-design" },
      { href: "/research/affective-computing/", text: "Affective computing, explained" },
      { href: "/research/publications/", text: "Publications" },
    ],
  },
  { href: "/achievements/", text: "Achievements" },
  { href: "/collaborate/", text: "Collaborate" },
  { href: "/take-part/", text: "Take Part" },
  { href: "/newsletter/", text: "Newsletter" },
  { href: "/contact/", text: "Contact" },
];

// "page" on the page itself, "true" anywhere inside its section (e.g. /newsletter/<post>/)
const currentState = (href: string) =>
  currentPath === href ? 'page' : currentPath.startsWith(href) ? 'true' : undefined;
const inSection = (link: NavLink) =>
  currentPath.startsWith(link.href) || (link.children ?? []).some((c) => currentPath.startsWith(c.href));
---
<header class="site-header">
  <div class="container">
    <a href="/" class="site-logo">MEMoPAD</a>

    {/* Hamburger Menu Button */}
    <button class="menu-toggle" aria-controls="primary-navigation" aria-expanded="false">
      <span class="sr-only">Menu</span>
      <svg aria-hidden="true" focusable="false" class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      <svg aria-hidden="true" focusable="false" class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <nav class="site-nav" id="primary-navigation" aria-label="Main">
      <div class="mobile-menu-header">
        <a href="/" class="mobile-menu-logo">MEMoPAD</a>
      </div>
      <hr class="mobile-menu-divider" />
      <ul class="nav-list">
        {navLinks.map((link, i) => {
          const isActive = inSection(link);
          const topLink = (
            <a href={link.href} class:list={[{ 'is-active': isActive }]} aria-current={currentPath === link.href ? 'page' : isActive ? 'true' : undefined}>
              {link.text}
            </a>
          );
          if (!link.children) return <li>{topLink}</li>;
          return (
            <li class="has-sub">
              <div class="nav-item-row">
                {topLink}
                <button type="button" class="submenu-toggle" aria-expanded="false" aria-controls={`submenu-${i}`}>
                  <span class="sr-only">{`${link.text}: show its pages`}</span>
                  <svg aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </button>
              </div>
              <ul class="submenu" id={`submenu-${i}`}>
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} class:list={[{ 'is-current': currentState(child.href) }]} aria-current={currentState(child.href)}>
                      {child.text}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ul>
      <hr class="mobile-menu-divider" />
      <div class="mobile-menu-contact">
        <a href={mailto()}>{PRIMARY_EMAIL}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const primaryNav = document.querySelector<HTMLElement>('.site-nav');
  if (menuToggle && primaryNav) {
    const setOpen = (open: boolean, returnFocus = false) => {
      menuToggle.setAttribute('aria-expanded', String(open));
      primaryNav.classList.toggle('is-open', open);
      document.body.classList.toggle('no-scroll', open);
      if (!open && returnFocus) menuToggle.focus();
    };
    menuToggle.addEventListener('click', () => {
      setOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
    });
    // Close with Escape and return focus to the toggle
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && primaryNav.classList.contains('is-open')) setOpen(false, true);
    });
    // Close after choosing a link (matters for same-page anchors)
    primaryNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }

  // Sub-menus: a dropdown on desktop (also opens on hover), a collapsible list in the mobile menu
  document.querySelectorAll<HTMLButtonElement>('.submenu-toggle').forEach((button) => {
    const item = button.closest<HTMLElement>('.has-sub');
    if (!item) return;
    const setSub = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      item.classList.toggle('is-open', open);
    };
    button.addEventListener('click', () => setSub(button.getAttribute('aria-expanded') !== 'true'));
    // Escape closes the sub-menu first (and keeps the mobile menu open)
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && item.classList.contains('is-open')) {
        e.stopPropagation();
        setSub(false);
        button.focus();
      }
    });
    // Close when focus or a click moves elsewhere
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget as Node | null)) setSub(false);
    });
    document.addEventListener('click', (e) => {
      if (!item.contains(e.target as Node)) setSub(false);
    });
  });
</script>

<style>
  /* Base Header Styles */
  .site-header { background-color: var(--color-white); border-bottom: 1px solid var(--color-border); padding: 1rem 0; position: sticky; top: 0; width: 100%; z-index: 100; }
  .container { max-width: 1100px; margin-left: auto; margin-right: auto; padding: 0 2rem; display: flex; justify-content: space-between; align-items: center; }
  .site-logo { font-size: 1.25rem; font-weight: 700; text-decoration: none; transition: color 0.2s ease; color: var(--color-primary-strong); }
  .site-logo:hover { color: var(--color-text); }

  /* Hamburger Menu Styles */
  .menu-toggle { display: none; background: none; border: none; cursor: pointer; padding: 0.5rem; }
  .icon-close { display: none; }
  .menu-toggle[aria-expanded="true"] .icon-menu { display: none; }
  .menu-toggle[aria-expanded="true"] .icon-close { display: block; }
  body.no-scroll { overflow: hidden; }
  .mobile-menu-header, .mobile-menu-divider, .mobile-menu-contact { display: none; }

  /* Desktop Navigation */
  .nav-list { list-style: none; display: flex; gap: 2rem; margin: 0; padding: 0; }
  .site-nav a {
    white-space: nowrap;
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.2s ease;
    position: relative;
    padding-bottom: 8px; /* Space for the underline */
  }
  .site-nav a:hover { color: var(--color-primary-strong); }

  .site-nav a.is-active {
    color: var(--color-primary-strong);
    font-weight: 700;
  }
  .site-nav a.is-active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--color-primary-strong);
  }

  /* Sub-menu (The Research): dropdown on desktop */
  .has-sub { position: relative; }
  /* Link and chevron sit inline, like the other links, so the active underline lines up */
  .nav-item-row { white-space: nowrap; }
  .submenu-toggle {
    display: inline-flex; align-items: center; justify-content: center; vertical-align: middle;
    background: none; border: none; border-radius: 4px; cursor: pointer;
    padding: 0.15rem; margin-left: 0.15rem;
    color: var(--color-text);
  }
  @media (hover: hover) {
    .submenu-toggle:hover { color: var(--color-primary-strong); background-color: var(--color-background); }
  }
  .submenu-toggle svg { transition: transform 0.2s ease; }
  .has-sub.is-open .submenu-toggle svg { transform: rotate(180deg); }
  .submenu {
    display: none; position: absolute; top: calc(100% + 1.2rem); left: -1rem; z-index: 200;
    min-width: 16rem; list-style: none; margin: 0; padding: 0.5rem 0;
    background-color: var(--color-white); border: 1px solid var(--color-border); border-radius: 8px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
  }
  .has-sub.is-open .submenu { display: block; }
  .site-nav .submenu a { display: block; padding: 0.6rem 1.25rem; font-size: 0.95rem; }
  @media (hover: hover) {
    .site-nav .submenu a:hover { background-color: var(--color-background); }
  }
  .site-nav .submenu a.is-current { color: var(--color-primary-strong); font-weight: 700; }
  @media (min-width: 1025px) {
    /* Invisible bridge so the dropdown stays open while the pointer moves down to it */
    .has-sub::after { content: ''; position: absolute; left: -1rem; right: 0; top: 100%; height: 1.4rem; }
  }
  @media (min-width: 1025px) and (hover: hover) {
    .has-sub:hover .submenu { display: block; }
  }

  /* Mobile Navigation Styles */
  /* Seven links don't fit on one line below ~1024px, so switch to the menu there */
  @media (max-width: 1024px) {
    .menu-toggle { display: block; z-index: 1001; }
    .site-nav { display: none; position: fixed; inset: 0; background-color: var(--color-white); padding: 1rem 2rem; z-index: 1000; flex-direction: column; overflow-y: auto; overscroll-behavior: contain; }
    .site-nav.is-open { display: flex; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; text-align: center; flex-grow: 1; justify-content: center; }
    .site-nav li { width: 100%; }
    .site-nav a { font-size: 1.5rem; display: block; padding: 1rem 0; border-radius: 4px; }
    .site-nav a:hover { background-color: var(--color-background); }
    .site-nav a.is-active::after { display: none; } /* Hide underline on mobile */
    .mobile-menu-header, .mobile-menu-contact { display: block; padding: 1rem 0; }
    .mobile-menu-logo { font-size: 1.25rem; font-weight: 700; text-decoration: none; color: var(--color-primary-strong); transition: color 0.2s ease; }
    .mobile-menu-logo:hover { color: var(--color-text); }
    .mobile-menu-divider { display: block; border: none; border-top: 1px solid var(--color-border); margin: 0; }
    .mobile-menu-contact a { font-size: 1rem; color: var(--color-text-muted); padding: 1rem 0; }

    /* Sub-menu: a collapsible list under its link; left padding keeps the link text centred */
    .nav-item-row { display: flex; align-items: center; justify-content: center; padding-left: 2.75rem; }
    .submenu-toggle { width: 2.75rem; height: 2.75rem; margin-left: 0; }
    .submenu-toggle svg { width: 22px; height: 22px; }
    .submenu { position: static; min-width: 0; padding: 0 0 0.5rem; background: none; border: none; box-shadow: none; }
    .site-nav .submenu a { font-size: 1.15rem; padding: 0.6rem 0; color: var(--color-text-muted); }
    .site-nav .submenu a.is-current { color: var(--color-primary-strong); }
  }
  /* Short screens (small phones, landscape): tighter links so they all fit; the panel scrolls if not */
  @media (max-width: 1024px) and (max-height: 760px) {
    .nav-list > li > a, .nav-item-row > a { font-size: 1.25rem; padding: 0.55rem 0; }
    .mobile-menu-header, .mobile-menu-contact { padding: 0.5rem 0; }
  }
</style>
