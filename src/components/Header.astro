---
import { PRIMARY_EMAIL, mailto } from '../data/project';

// Get the current page's path to determine the active link
const currentPath = Astro.url.pathname;

// Define navigation links in an array for easier management
const navLinks = [
  { href: "/project-story/", text: "Project Story" },
  { href: "/research/", text: "The Research" },
  { href: "/publications/", text: "Publications" },
  { href: "/achievements/", text: "Achievements" },
  { href: "/collaborate/", text: "Collaborate" },
  { href: "/take-part/", text: "Take Part" },
  { href: "/newsletter/", text: "Newsletter" },
  { href: "/contact/", text: "Contact" },
];
---
<header class="site-header">
  <div class="container">
    <a href="/" class="site-logo">MEMoPAD</a>

    {/* Hamburger Menu Button */}
    <button class="menu-toggle" aria-controls="primary-navigation" aria-expanded="false">
      <span class="sr-only">Menu</span>
      <svg aria-hidden="true" focusable="false" class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      <svg aria-hidden="true" focusable="false" class="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <nav class="site-nav" id="primary-navigation" aria-label="Main">
      <div class="mobile-menu-header">
        <a href="/" class="mobile-menu-logo">MEMoPAD</a>
      </div>
      <hr class="mobile-menu-divider" />
      <ul>
        {navLinks.map(link => {
          // Check if the current path starts with the link's href.
          // This handles sub-pages like /newsletter/post correctly.
          const isActive = currentPath.startsWith(link.href);
          return (
            <li>
              <a href={link.href} class:list={[{ 'is-active': isActive }]} aria-current={isActive ? 'page' : undefined}>
                {link.text}
              </a>
            </li>
          );
        })}
      </ul>
      <hr class="mobile-menu-divider" />
      <div class="mobile-menu-contact">
        <a href={mailto()}>{PRIMARY_EMAIL}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const primaryNav = document.querySelector<HTMLElement>('.site-nav');
  if (menuToggle && primaryNav) {
    const setOpen = (open: boolean, returnFocus = false) => {
      menuToggle.setAttribute('aria-expanded', String(open));
      primaryNav.classList.toggle('is-open', open);
      document.body.classList.toggle('no-scroll', open);
      if (!open && returnFocus) menuToggle.focus();
    };
    menuToggle.addEventListener('click', () => {
      setOpen(menuToggle.getAttribute('aria-expanded') !== 'true');
    });
    // Close with Escape and return focus to the toggle
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && primaryNav.classList.contains('is-open')) setOpen(false, true);
    });
    // Close after choosing a link (matters for same-page anchors)
    primaryNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>

<style>
  /* Base Header Styles */
  .site-header { background-color: var(--color-white); border-bottom: 1px solid var(--color-border); padding: 1rem 0; position: sticky; top: 0; width: 100%; z-index: 100; }
  .container { max-width: 1100px; margin-left: auto; margin-right: auto; padding: 0 2rem; display: flex; justify-content: space-between; align-items: center; }
  .site-logo { font-size: 1.25rem; font-weight: 700; text-decoration: none; transition: color 0.2s ease; color: var(--color-primary-strong); }
  .site-logo:hover { color: var(--color-text); }

  /* Hamburger Menu Styles */
  .menu-toggle { display: none; background: none; border: none; cursor: pointer; padding: 0.5rem; }
  .icon-close { display: none; }
  .menu-toggle[aria-expanded="true"] .icon-menu { display: none; }
  .menu-toggle[aria-expanded="true"] .icon-close { display: block; }
  body.no-scroll { overflow: hidden; }
  .mobile-menu-header, .mobile-menu-divider, .mobile-menu-contact { display: none; }

  /* Desktop Navigation */
  .site-nav ul { list-style: none; display: flex; gap: 1.5rem; margin: 0; padding: 0; }
  .site-nav a {
    white-space: nowrap;
    color: var(--color-text);
    text-decoration: none;
    font-size: 1rem;
    transition: color 0.2s ease;
    position: relative;
    padding-bottom: 8px; /* Space for the underline */
  }
  .site-nav a:hover { color: var(--color-primary-strong); }

  .site-nav a.is-active {
    color: var(--color-primary-strong);
    font-weight: 700;
  }
  .site-nav a.is-active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--color-primary-strong);
  }

  /* Mobile Navigation Styles */
  /* Eight links need the full 1100px container, so switch to the menu below it */
  @media (max-width: 1099px) {
    .menu-toggle { display: block; z-index: 1001; }
    .site-nav { display: none; position: fixed; inset: 0; background-color: var(--color-white); padding: 1rem 2rem; z-index: 1000; flex-direction: column; overflow-y: auto; overscroll-behavior: contain; }
    .site-nav.is-open { display: flex; }
    .site-nav ul { flex-direction: column; align-items: stretch; gap: 0; text-align: center; flex-grow: 1; justify-content: center; }
    .site-nav li { width: 100%; }
    .site-nav a { font-size: 1.5rem; display: block; padding: 1rem 0; border-radius: 4px; }
    .site-nav a:hover { background-color: var(--color-background); }
    .site-nav a.is-active::after { display: none; } /* Hide underline on mobile */
    .mobile-menu-header, .mobile-menu-contact { display: block; padding: 1rem 0; }
    .mobile-menu-logo { font-size: 1.25rem; font-weight: 700; text-decoration: none; color: var(--color-primary-strong); transition: color 0.2s ease; }
    .mobile-menu-logo:hover { color: var(--color-text); }
    .mobile-menu-divider { display: block; border: none; border-top: 1px solid var(--color-border); margin: 0; }
    .mobile-menu-contact a { font-size: 1rem; color: var(--color-text-muted); padding: 1rem 0; }
  }
  /* Short screens (small phones, landscape): tighter links so all eight fit; the panel scrolls if not */
  @media (max-width: 1099px) and (max-height: 760px) {
    .site-nav ul a { font-size: 1.25rem; padding: 0.55rem 0; }
    .mobile-menu-header, .mobile-menu-contact { padding: 0.5rem 0; }
  }
</style>
