---
// "Cite or link to MEMoPAD" block. Used on the home page and the Publications page.
// Citations come from src/data/publications.ts, so they stay in sync with the paper pages.
import { SITE_URL, PROJECT } from '../data/project';
import { getPublication, formatCitation, toBibtex } from '../data/publications';

type Props = { headingLevel?: 'h2' | 'h3'; showMoreLink?: boolean };
const { headingLevel = 'h2', showMoreLink = true } = Astro.props;
const Heading = headingLevel;
const Sub = headingLevel === 'h2' ? 'h3' : 'h4';

const system = getPublication('memopad-interactive-health-2026');
const review = getPublication('affective-computing-anxiety-disorders-review-2025');
const linkSnippet = `<a href="${SITE_URL}/">MEMoPAD (${PROJECT.acronym})</a>`;
---
<section class="cite-project" aria-labelledby="cite-project-heading">
  <Heading id="cite-project-heading">Cite or link to MEMoPAD</Heading>
  <p>
    Writing about the project? Please call it <strong>MEMoPAD</strong> ({PROJECT.acronym}), a UWE Bristol PhD project, and link to
    <a href={`${SITE_URL}/`}>memopad.luigiandreamoretti.com</a>.
  </p>
  <details>
    <summary>HTML link</summary>
    <pre><code>{linkSnippet}</code></pre>
  </details>

  <Sub>To cite the MEMoPAD system</Sub>
  <p class="citation">{formatCitation(system)}</p>
  <details>
    <summary>BibTeX</summary>
    <pre><code>{toBibtex(system)}</code></pre>
  </details>

  <Sub>To cite our review of affective computing in anxiety disorders</Sub>
  <p class="citation">{formatCitation(review)}</p>
  <details>
    <summary>BibTeX</summary>
    <pre><code>{toBibtex(review)}</code></pre>
  </details>

  {showMoreLink && <p class="cite-more"><a href="/research/publications/">All publications, with abstracts and PDFs</a></p>}
</section>

<style>
  .cite-project {
    background-color: var(--color-white);
    border-left: 4px solid var(--color-primary);
    border-radius: 8px;
    padding: 1.5rem 2rem;
    max-width: 800px;
    margin: 3rem auto;
  }
  .cite-project h2, .cite-project h3 { margin-bottom: 0.75rem; }
  .cite-project h3, .cite-project h4 { margin-top: 1.5rem; margin-bottom: 0.5rem; font-size: 1.05rem; }
  .cite-project p { color: var(--color-text); }
  .cite-project a { color: var(--color-primary-strong); font-weight: 700; }
  .citation { font-size: 0.95rem; line-height: 1.6; overflow-wrap: anywhere; }
  details { margin-top: 0.5rem; }
  summary { cursor: pointer; font-weight: 700; color: var(--color-primary-strong); font-size: 0.9rem; }
  pre {
    margin-top: 0.5rem;
    padding: 1rem;
    background-color: var(--color-background);
    border-radius: 4px;
    font-size: 0.8rem;
    line-height: 1.5;
    overflow-x: auto;
    white-space: pre;
  }
  .cite-more { margin-top: 1.5rem; }
  @media (max-width: 600px) {
    .cite-project { padding: 1.25rem; }
  }
</style>
