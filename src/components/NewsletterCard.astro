---
// src/components/NewsletterCard.astro
// This component displays a preview of a single newsletter issue.
type Props = {
  href: string;
  title: string;
  issue: string;
  date: Date;
  excerpt: string;
};

const { href, title, issue, date, excerpt } = Astro.props;
---
<a href={href} class="card-link">
  <article class="newsletter-card">
    <p class="card-date"><time datetime={date.toISOString()}>{issue}</time></p>
    <h2 class="card-title">{title}</h2>
    <p class="card-excerpt">{excerpt}</p>
    <span class="card-readmore" aria-hidden="true">Read more &rarr;</span>
  </article>
</a>

<style>
  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.07);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    background-color: var(--color-white);
  }
  .card-link:hover {
    box-shadow: 0 8px 30px rgba(0,0,0,0.15);
    transform: translateY(-5px);
  }
  .newsletter-card {
    padding: 2rem;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .card-date {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .card-title {
    font-size: 1.35rem;
    color: var(--color-primary-strong);
    line-height: 1.3;
    margin-bottom: 1rem;
  }
  .card-excerpt {
    flex-grow: 1;
    color: var(--color-text-muted);
  }
  .card-readmore {
    margin-top: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-strong);
  }
</style>
