---
// src/components/RecruitmentCard.astro
// A recruitment call: text, what's involved and a call to action on the left,
// an optional one-page summary preview on the right.
type Props = {
  title: string;
  buttonText: string;
  buttonLink: string;
  status?: 'open' | 'closed';
  involvementDetails?: string[];
  documentImageUrl?: string;
  documentPdfUrl?: string;
  note?: string;
};

const {
  title,
  buttonText,
  buttonLink,
  status = 'open',
  involvementDetails,
  documentImageUrl,
  documentPdfUrl,
  note,
} = Astro.props;
---

<article class:list={['recruitment-card', `is-${status}`, { 'has-document': documentImageUrl && documentPdfUrl }]} data-card="recruitment">
  <div class="card-main">
    <p class="status-pill">{status === 'open' ? 'Recruiting now' : 'Recruitment closed'}</p>
    <h2>{title}</h2>
    <div class="description">
      <slot />
    </div>

    {involvementDetails && involvementDetails.length > 0 && (
      <div class="involvement">
        <h3>What's involved</h3>
        <ul>
          {involvementDetails.map((detail) => <li>{detail}</li>)}
        </ul>
      </div>
    )}

    {note && <p class="note">{note}</p>}

    {status === 'open' && (
      <div class="actions">
        <a href={buttonLink} class="button" target="_blank" rel="noopener noreferrer">{buttonText}</a>
      </div>
    )}
  </div>

  {documentPdfUrl && (
    <a href={documentPdfUrl} class="document-link" target="_blank" rel="noopener noreferrer">
      {documentImageUrl && <img src={documentImageUrl} alt="" width="535" height="757" loading="lazy" />}
      <span>One-page summary (PDF)</span>
    </a>
  )}
</article>

<style>
  .recruitment-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-top: 5px solid var(--color-primary-strong);
    border-radius: 12px;
    padding: 2.5rem;
  }
  .recruitment-card.is-closed {
    border-top-color: var(--color-border);
  }
  @media (min-width: 768px) {
    .recruitment-card.has-document {
      grid-template-columns: 1fr 200px;
      gap: 3rem;
      align-items: center;
    }
  }

  .status-pill {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-radius: 999px;
    padding: 0.2rem 0.75rem;
    margin-bottom: 1rem;
    background-color: var(--color-primary-dark);
    color: var(--color-white);
  }
  .is-closed .status-pill {
    background-color: var(--color-background);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  h2 {
    text-wrap: balance;
    font-size: 1.75rem;
    line-height: 1.25;
    margin-bottom: 1rem;
  }
  .description {
    line-height: 1.7;
    color: var(--color-text);
  }
  .description :global(p) {
    margin-bottom: 1rem;
  }

  .involvement {
    margin: 1.25rem 0;
    padding: 1rem 1.25rem;
    background-color: var(--color-background);
    border-radius: 8px;
  }
  .involvement h3 {
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }
  .involvement ul {
    padding-left: 1.25rem;
    line-height: 1.7;
  }

  .note {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .actions {
    margin-top: 0.5rem;
  }

  /* One-page summary: thumbnail + caption on wide screens, plain link on phones */
  .document-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    justify-self: center;
    color: var(--color-primary-strong);
    font-weight: 700;
    font-size: 0.95rem;
    text-align: center;
  }
  .document-link img {
    width: 200px;
    height: auto;
    display: block;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .document-link:hover img {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14);
  }
  .document-link span {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 767px) {
    .recruitment-card {
      padding: 1.75rem 1.5rem;
      gap: 1.25rem;
    }
    .document-link {
      justify-self: start;
      align-items: flex-start;
    }
    .document-link img {
      display: none;
    }
    .actions .button {
      width: 100%;
    }
  }
</style>
