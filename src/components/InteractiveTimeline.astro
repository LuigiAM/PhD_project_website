---
// src/components/InteractiveTimeline.astro
// Accessible tabs (one per category) over a vertical timeline.
// Data lives in src/data/achievements.ts. Each panel id doubles as a deep link,
// e.g. /achievements/#co-design-milestones opens that tab.
import TimelineItem from './TimelineItem.astro';
import { ACHIEVEMENTS } from '../data/achievements';
---
<div class="timeline-tabs" data-timeline-component>
  <div class="tabs-scroller">
    <div class="tabs-track" role="tablist" aria-label="Achievement categories">
      {ACHIEVEMENTS.map((category, index) => (
        <button
          class="timeline-tab"
          type="button"
          role="tab"
          id={`tab-${category.id}`}
          aria-controls={category.id}
          aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1}
        >
          {category.name}
        </button>
      ))}
    </div>
  </div>

  {ACHIEVEMENTS.map((category, index) => (
    <section
      class="timeline-panel"
      role="tabpanel"
      id={category.id}
      aria-labelledby={`tab-${category.id}`}
      tabindex="0"
      hidden={index !== 0}
    >
      <h2 class="sr-only">{category.name}</h2>
      <div class="timeline-wrapper">
        <div class="timeline-line"></div>
        {category.items.map((item, i) => (
          <TimelineItem
            date={item.label}
            datetime={item.date}
            title={item.title}
            position={i % 2 === 0 ? 'left' : 'right'}
            icon={category.icon}
          >
            <p set:html={item.html} />
          </TimelineItem>
        ))}
      </div>
    </section>
  ))}
</div>

<noscript>
  <style>.timeline-panel[hidden] { display: block; }</style>
</noscript>

<script>
  const initTimelineTabs = (container: HTMLElement) => {
    const tabs = Array.from(container.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(container.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    const scroller = container.querySelector<HTMLElement>('.tabs-scroller');
    if (tabs.length === 0 || panels.length !== tabs.length) return;

    let currentIndex = 0;

    const select = (index: number, { focus = false, updateHash = false } = {}) => {
      if (index < 0 || index >= tabs.length) return;
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
      });
      currentIndex = index;
      const active = tabs[index];
      if (focus) active.focus();
      if (scroller) {
        const offset = active.offsetLeft + active.offsetWidth / 2 - scroller.offsetWidth / 2;
        scroller.scrollTo({ left: offset, behavior: 'smooth' });
      }
      if (updateHash) history.replaceState(null, '', `#${panels[index].id}`);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index, { updateHash: true }));
      tab.addEventListener('keydown', (e) => {
        const keyMap: Record<string, number> = {
          ArrowRight: (index + 1) % tabs.length,
          ArrowLeft: (index - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (e.key in keyMap) {
          e.preventDefault();
          select(keyMap[e.key], { focus: true, updateHash: true });
        }
      });
    });

    // Swipe between categories on touch devices
    let touchStartX = 0;
    let touchStartY = 0;
    container.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      touchStartY = e.changedTouches[0].screenY;
    }, { passive: true });
    container.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].screenX - touchStartX;
      const dy = e.changedTouches[0].screenY - touchStartY;
      if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy)) return;
      const next = dx < 0 ? currentIndex + 1 : currentIndex - 1;
      if (next >= 0 && next < tabs.length) select(next, { updateHash: true });
    });

    // Open the tab named in the URL hash (deep links from other pages)
    const selectFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      const index = panels.findIndex((panel) => panel.id === id);
      if (index >= 0) {
        select(index);
        container.scrollIntoView({ block: 'start' });
      }
    };
    selectFromHash();
    window.addEventListener('hashchange', selectFromHash);
  };

  document.querySelectorAll<HTMLElement>('[data-timeline-component]').forEach(initTimelineTabs);
</script>

<style>
  .timeline-tabs { position: relative; padding: 2rem 0; scroll-margin-top: 5rem; }
  .tabs-scroller {
    display: flex;
    border-bottom: 1px solid var(--color-border);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs-scroller::-webkit-scrollbar { display: none; }
  .tabs-track { display: flex; gap: 1rem; margin: 0 auto; }
  .timeline-tab {
    background: none;
    border: none;
    border-bottom: 4px solid transparent;
    padding: 0.75rem 1rem;
    font: inherit;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .timeline-tab:hover { color: var(--color-text); }
  .timeline-tab[aria-selected="true"] {
    color: var(--color-primary-strong);
    border-bottom-color: var(--color-primary-strong);
  }
  .timeline-tab:focus-visible { outline-offset: -3px; }
  .timeline-panel:focus-visible { outline-offset: 4px; }

  .timeline-wrapper { position: relative; max-width: 900px; margin: 0 auto; padding: 2rem 0; }
  .timeline-line { position: absolute; top: 0; bottom: 0; left: 50%; width: 4px; background-color: var(--color-border); transform: translateX(-50%); }
  .timeline-panel :global(.timeline-description a) {
    color: var(--color-primary-strong);
    font-weight: 700;
  }

  @media (max-width: 768px) {
    .tabs-track { margin: 0; }
    .timeline-wrapper { padding: 2rem 1rem; }
    .timeline-line { left: 23px; }
  }
</style>
