---
// src/components/DemoCard.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import YouTubeEmbed from './YouTubeEmbed.astro';

type Props = {
  title: string;
  description: string;
  videoId?: string;
  poster?: ImageMetadata;
  linkUrl?: string;
  img?: ImageMetadata;
  imgAlt?: string;
  badge?: string;
};

const { title, description, videoId, poster, linkUrl, img, imgAlt, badge } = Astro.props;
---
<div class="demo-card">
  <div class="media-container">
    {videoId && poster ? (
      <YouTubeEmbed id={videoId} title={title} poster={poster} sizes="(max-width: 900px) 100vw, 360px" />
    ) : img && linkUrl ? (
      <a href={linkUrl} target="_blank" rel="noopener noreferrer" class="image-link">
        <Image src={img} alt={imgAlt ?? `Screenshot of the ${title} (opens in a new tab)`} widths={[400, 800]} width={Math.min(800, img.width)} sizes="(max-width: 900px) 100vw, 360px" />
      </a>
    ) : img ? (
      <Image src={img} alt={imgAlt ?? ''} widths={[400, 800]} width={Math.min(800, img.width)} sizes="(max-width: 900px) 100vw, 360px" />
    ) : null}
  </div>
  <div class="text-content">
    {badge && <p class="badge">{badge}</p>}
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</div>

<style>
  .demo-card {
    background-color: var(--color-white);
    border-radius: 12px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
  }
  .media-container {
    background-color: #000;
    line-height: 0;
  }
  .media-container :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .image-link {
    display: block;
    overflow: hidden;
  }
  .image-link :global(img) {
    transition: transform 0.3s ease;
  }
  .image-link:hover :global(img) {
    transform: scale(1.03);
  }
  .text-content {
    padding: 1.5rem;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin-bottom: 0.75rem;
  }
  .text-content h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .text-content p:not(.badge) {
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
